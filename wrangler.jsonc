{
  
  "name": "algoritmalar",
  "main": "worker/index.js",
  // Bugünden ileri bir tarih yazmayın.
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "algoritmalar",
            "database_id": "40c206ab-af78-4972-b5f3-1de39ced353a"
    }
  ],
  
  "vars": {
    "GITHUB_REPO": "bilaltozluyurt/algoritmalar"
    
  },
  "observability": { "enabled": true }
}
